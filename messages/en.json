  "faqPage": {
    "sectionTitle": "Frequently Asked Questions",
    "sectionDescription": "If you have any questions, the answer might be here!",
    "faqs": [
      {
        "question": "What is readhub?",
        "answer": "readhub is a platform that offers both physical and digital books across various categories to provide a comprehensive and enjoyable reading experience."
      },
      {
        "question": "How can I buy a book?",
        "answer": "You can browse books through the dedicated section, choose the one you like, then click 'Buy' to proceed with the purchase."
      },
      {
        "question": "Are there free books available?",
        "answer": "Yes, we offer a collection of free books you can download at no cost. Look for the 'Free' category in our store."
      },
      {
        "question": "How do I contact customer support?",
        "answer": "You can reach out to our support team through the Contact page or via the email address provided at the bottom of the site."
      },
      {
        "question": "Do you support Arabic language?",
        "answer": "Yes! We support both English and Arabic. You can switch languages using the language button in the header."
      },
      {
        "question": "How long does shipping take?",
        "answer": "Shipping usually takes between 3 to 7 business days depending on your location."
      },
      {
        "question": "Can I return a book after purchase?",
        "answer": "Yes, you can return physical books within 14 days of delivery if they are in original condition."
      },
      {
        "question": "Are there discounts for bulk purchases?",
        "answer": "Yes, we offer special pricing and discounts for bulk orders. Contact our sales team for more information."
      },
      {
        "question": "Is my payment information secure?",
        "answer": "Absolutely. We use industry-standard encryption and security measures to protect your payment details."
      },
      {
        "question": "Do you offer refunds for digital books?",
        "answer": "Unfortunately, due to the nature of digital products, we do not offer refunds for downloaded eBooks."
      }
    ]
  },
